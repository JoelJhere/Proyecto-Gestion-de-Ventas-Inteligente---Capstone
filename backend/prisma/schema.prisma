// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- 1. MODELO CORE SAAS (EL INQUILINO / TENANT) ---
model Negocio {
  id                 Int      @id @default(autoincrement())
  razonSocial        String   @default("") 
  nombre             String   @default("Mi Negocio") 
  ruc                String   @default("") 
  direccionFiscal    String   @default("") 
  ciudad             String   @default("") 
  departamento       String   @default("") 
  telefono           String   @default("") 
  email              String   @default("") 
  mensajeTicket      String?  @default("¡Gracias por su preferencia!")
  impuestoPorcentaje Float    @default(18.0) 
  logo               String?
  
  // Credenciales SUNAT
  nubefactRuta       String?  @default("")
  nubefactToken      String?  @default("")
  
  // Relaciones SaaS (Todo lo que pertenece a este negocio)
  usuarios           User[]
  productos          Producto[]
  proveedores        Proveedor[]
  ventas             Venta[]
  clientes           Cliente[]
  planesCompra       PlanCompra[]
  
  estado             Boolean  @default(true) // Permite al SUPER_ADMIN suspender un negocio
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// --- 2. USUARIOS (Super Admin, Dueños y Ayudantes) ---
model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       Role     @default(AYUDANTE)
  estado    Boolean  @default(true) 
  terminosAceptados Boolean  @default(false)
  
  // Relación con el negocio (Opcional porque el SUPER_ADMIN no tiene bodega)
  negocioId Int?
  negocio   Negocio? @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  
  ventas    Venta[]
  createdAt DateTime @default(now())
}

// --- 3. PROVEEDORES ---
model Proveedor {
  id           Int          @id @default(autoincrement())
  nombre       String
  ruc          String?      
  telefono     String?
  
  negocioId    Int
  negocio      Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  
  productos    Producto[]
  planesCompra PlanCompra[]
  createdAt    DateTime     @default(now())

  @@unique([ruc, negocioId]) // Un RUC es único por negocio, no global
}

// --- 4. PRODUCTOS ---
model Producto {
  id             Int      @id @default(autoincrement())
  codigo         String   
  nombre         String
  categoria      String?  
  precioCompra   Float?   
  precioVenta    Float    
  stock          Int      @default(0)
  estado         Boolean  @default(true) 
  stockMinimo    Int      @default(3)    
  unidadMedida   String   @default("Unidades") 

  negocioId      Int
  negocio        Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  proveedorId    Int?
  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  
  movimientos    MovimientoInventario[]
  detalles       DetalleVenta[]
  detallesCompra DetallePlanCompra[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([codigo, negocioId]) // El código de barras es único POR NEGOCIO
}

// --- 5. MOVIMIENTOS DE INVENTARIO ---
model MovimientoInventario {
  id         Int            @id @default(autoincrement())
  productoId Int
  producto   Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo       TipoMovimiento 
  cantidad   Int      
  motivo     String?  
  createdAt  DateTime       @default(now())
}

// --- 6. VENTAS (CABECERA) ---
model Venta {
  id                Int             @id @default(autoincrement())
  
  negocioId         Int
  negocio           Negocio         @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  
  vendedorId        Int
  vendedor          User            @relation(fields: [vendedorId], references: [id])
  
  tipoComprobante   TipoDocumento  
  numeroComprobante String?        
  clienteNombre     String?         @default("Cliente Varios")
  clienteDocumento  String?         
  enlacePdf         String?        
  
  subtotal          Float
  igv               Float
  total             Float
  
  detalles          DetalleVenta[]
  createdAt         DateTime        @default(now())
  cuentaPorCobrar   CuentaPorCobrar? 
}

// --- 7. DETALLE DE VENTAS ---
model DetalleVenta {
  id          Int      @id @default(autoincrement())
  ventaId     Int
  venta       Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId  Int
  producto    Producto @relation(fields: [productoId], references: [id])
  cantidad    Int
  precioVenta Float    
  subtotal    Float
}

// --- 8. COMPRAS A PROVEEDORES ---
model PlanCompra {
  id            Int                 @id @default(autoincrement())
  
  negocioId     Int
  negocio       Negocio             @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  
  fechaCreacion DateTime            @default(now())
  fechaEsperada DateTime? 
  fechaRecibido DateTime? 
  estado        String              @default("PENDIENTE") 
  totalEsperado Float               @default(0) 
  totalReal     Float               @default(0) 
  
  proveedorId   Int
  proveedor     Proveedor           @relation(fields: [proveedorId], references: [id])
  detalles      DetallePlanCompra[]
}

model DetallePlanCompra {
  id               Int        @id @default(autoincrement())
  cantidadEsperada Int        
  cantidadRecibida Int        @default(0) 
  precioCompra     Float      
  
  planCompraId     Int
  planCompra       PlanCompra @relation(fields: [planCompraId], references: [id], onDelete: Cascade)
  
  productoId       Int
  producto         Producto   @relation(fields: [productoId], references: [id])
}

// --- 9. CLIENTES (FIADOS) ---
model Cliente {
  id        Int               @id @default(autoincrement())
  nombre    String
  telefono  String?  
  
  negocioId Int
  negocio   Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  
  fiados    CuentaPorCobrar[] 
  createdAt DateTime          @default(now())
}

model CuentaPorCobrar {
  id            Int         @id @default(autoincrement())
  clienteId     Int
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ventaId       Int         @unique
  venta         Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  
  monto         Float    
  estado        EstadoFiado @default(PENDIENTE)
  fechaLimite   DateTime? 
  fechaPago     DateTime? 
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  recordatorios Int         @default(0)
}

// --- ENUMS ---
enum Role {
  SUPER_ADMIN
  ADMIN
  AYUDANTE
}

enum EstadoFiado {
  PENDIENTE
  PAGADO
}

enum TipoMovimiento {
  ABASTECIMIENTO
  DEVOLUCION
  VENTA
  AJUSTE_NEGATIVO
}

enum TipoDocumento {
  BOLETA
  FACTURA
  SIN_COMPROBANTE
}